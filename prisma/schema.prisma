generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ======================== USER ========================
model User {
  id                String    @id @default(uuid())
  name              String
  firstName         String?
  lastName          String?
  email             String    @unique
  password          String
  role              String    @default("USER") // SUPER_ADMIN, SUB_AGENT, USER
  status            String    @default("ACTIVE") // ACTIVE, SUSPENDED, LOCKED
  avatar            String?
  phone             String?
  agentId           String?   // Sub-Agent who referred this user
  invitationCode    String?   // Code used at registration (immutable unless SUPER_ADMIN changes it)
  referredBy        String?
  mustChangePassword  Boolean   @default(false)
  passwordChangedAt  DateTime?
  lastLogin          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  wallets      Wallet[]
  transactions Transaction[]
  trades       Trade[]
  notifications Notification[]

  @@index([email])
  @@index([role])
  @@index([agentId])
  @@index([invitationCode])
}

// ======================== WALLET ========================
model Wallet {
  id          String   @id @default(uuid())
  userId      String
  type        String   @default("SPOT") // SPOT, FUTURES, EARN
  status      String   @default("ACTIVE") // ACTIVE, FROZEN
  totalEquity Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  balances    WalletBalance[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
}

// ======================== WALLET BALANCE ========================
model WalletBalance {
  id        String  @id @default(uuid())
  walletId  String
  currency  String
  amount    Float   @default(0)
  frozen    Float   @default(0)

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([walletId, currency])
  @@index([walletId])
}

// ======================== TRANSACTION ========================
model Transaction {
  id          String   @id @default(uuid())
  userId      String
  type        String   // DEPOSIT, WITHDRAW, TRADE, COMMISSION, REFERRAL_BONUS, TRANSFER
  status      String   @default("PENDING") // PENDING, COMPLETED, FAILED, CANCELLED
  currency    String
  amount      Float
  fee         Float    @default(0)
  fromWallet  String?
  toWallet    String?
  tradeId     String?
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, type])
  @@index([createdAt(sort: Desc)])
}

// ======================== TRADE ========================
model Trade {
  id         String    @id @default(uuid())
  userId     String
  symbol     String
  side       String    // BUY, SELL
  type       String    @default("MARKET") // MARKET, LIMIT, STOP_LOSS, TAKE_PROFIT
  status     String    @default("OPEN") // OPEN, CLOSED, CANCELLED, LIQUIDATED
  entryPrice Float
  exitPrice  Float?
  quantity   Float
  leverage   Int       @default(1)
  margin     Float
  pnl        Float     @default(0)
  pnlPercent Float     @default(0)
  stopLoss   Float?
  takeProfit Float?
  agentId    String?
  closedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([symbol])
  @@index([agentId])
  @@index([createdAt(sort: Desc)])
}

// ======================== REFERRAL ========================
model Referral {
  id              String   @id @default(uuid())
  referrerId      String
  referredId      String
  referralCode    String
  level           Int      @default(1)
  totalCommission Float    @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@unique([referrerId, referredId])
  @@index([referrerId])
  @@index([referredId])
}

// ======================== INVITATION CODE ========================
// Sub-Agent codes (role=AGENT_CODE): reusable, createdBy = Sub-Agent's ID, never marked USED
// User codes (role=USER): single-use, created by admin or Sub-Agent
model InvitationCode {
  id        String    @id @default(uuid())
  code      String    @unique
  role      String    // AGENT_CODE (reusable Sub-Agent code), USER (single-use)
  createdBy String    // Owner: Sub-Agent ID for AGENT_CODE, admin/agent for USER
  usedBy    String?
  status    String    @default("UNUSED") // UNUSED, USED, DISABLED
  usedAt    DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([code])
  @@index([createdBy])
}

// ======================== AGENT CONFIG ========================
model AgentConfig {
  agentId         String   @unique
  commissionRate  Float    @default(0.15)
  referralRate    Float    @default(0.05)
  maxUsers        Int      @default(100)
  maxLeverage     Int      @default(100)
  allowedSymbols  String[] @default(["BTCUSDT", "ETHUSDT", "BNBUSDT"])
  riskLimit       Float    @default(100000)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ======================== NOTIFICATION ========================
model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // SYSTEM, TRADE, WALLET, SECURITY, COMMISSION, REFERRAL
  priority  String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  title     String
  message   String
  read      Boolean  @default(false)
  actionUrl String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
  @@index([createdAt(sort: Desc)])
}

// ======================== SYSTEM SETTING ========================
model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// ======================== LOGIN LOG ========================
model LoginLog {
  id        String   @id @default(uuid())
  userId    String
  email     String
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([email])
  @@index([createdAt(sort: Desc)])
}